# ---------------------------------------------------------------------------
# Copy to .env.local for local development, and add the same NEXT_PUBLIC_*
# values to your Vercel project (Settings -> Environment Variables).
#
# Everything prefixed NEXT_PUBLIC_ is embedded in the browser bundle. That is
# intended: these are public identifiers, and Appwrite enforces access with
# user sessions and per-row permissions, not by keeping IDs secret.
#
# APPWRITE_API_KEY is a SECRET. It is only used by `npm run setup`, which runs
# on your machine. Never prefix it with NEXT_PUBLIC_, never add it to Vercel,
# and never commit a filled-in .env.local.
# ---------------------------------------------------------------------------

# Your Appwrite API endpoint. Appwrite Cloud shows this on the project overview;
# use the region your project lives in (fra, nyc, syd, ...).
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1

# Appwrite project ID (Project overview -> Project ID).
NEXT_PUBLIC_APPWRITE_PROJECT_ID=

# Database and table IDs. These match the defaults created by `npm run setup`.
NEXT_PUBLIC_APPWRITE_DATABASE_ID=chat
NEXT_PUBLIC_APPWRITE_PROFILES_TABLE_ID=profiles
NEXT_PUBLIC_APPWRITE_MESSAGES_TABLE_ID=messages

# ---------------------------------------------------------------------------
# Server-side only, for `npm run setup`. Leave blank unless you are running it.
# ---------------------------------------------------------------------------
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
